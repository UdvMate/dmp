<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="dmApp.MainPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navbar -->
        <StackLayout Grid.Column="0" BackgroundColor="LightGray">
            <Label Text="Home" Padding="10" />
            <Label Text="Flashcards" Padding="10" />
        </StackLayout>

        <!-- Main Content -->
        <ContentView Grid.Column="1">
            <Label Text="Welcome to dmApp!" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" />
        </ContentView>
    </Grid>
</ContentPage>
