<Window x:Class="dmp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dmp"
        mc:Ignorable="d"
        Title="RegisterWindow" Height="450" Width="388">
    <Grid>
        <TextBlock Text="Username:" HorizontalAlignment="Left" Margin="30,50,0,363"/>
        <TextBox x:Name="UsernameTextBox" HorizontalAlignment="Left" Margin="120,50,0,363" Width="200"/>
        <TextBlock Text="Email:" HorizontalAlignment="Left" Margin="30,100,0,316"/>
        <TextBox x:Name="EmailTextBox" HorizontalAlignment="Left" Margin="120,100,0,316" Width="200"/>
        <TextBlock Text="Password:" HorizontalAlignment="Left" Margin="30,150,0,262"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Margin="120,150,0,262" Width="200"/>
        <Button Content="Register" HorizontalAlignment="Left" Margin="180,192,0,202" Width="80" Height="40" Click="RegisterButton_Click"/>

    </Grid>
</Window>
