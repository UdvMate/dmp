<Window x:Class="dmp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flashcard.ai"
        Width="900"
        Height="600"
        Background="#171b21"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          Color="#000000"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.4"/>
    </Window.Resources>

    <Grid>
        
        <Grid>
            <Image Source="assets/icon2.png" Margin="10,25,0,0" Width="50" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock Text="Flashcard.ai"
           FontSize="32"
           FontWeight="Bold"
           Foreground="White"
           Margin="70,25,0,0"
            />
            
        </Grid>
        <!-- Account Button and Popup -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0">
            
            <Button x:Name="AccountButton"
                    Content="Account"
                    Width="100"
                    Height="30"
                    Click="AccountButton_Click"
                    Background="#3b82f6"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>
            <Popup x:Name="AccountPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=AccountButton}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="#0e1116"
                        CornerRadius="8"
                        Padding="10"
                        BorderBrush="#3b82f6"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UserInfoText"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                        <Button Content="Logout"
                                Width="100"
                                Click="Logout_Click"
                                Background="#3b82f6"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <TextBlock x:Name="NoCardsText"
           Text="You don't have any cards yet."
           FontSize="22"
           FontWeight="Bold"
           Foreground="White"
           Visibility="Collapsed"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextAlignment="Center"/>

        <!-- Flashcards Area -->
        <DockPanel Margin="0,60,0,50">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="FlashcardsPanel"
                             Columns="3"
                             HorizontalAlignment="Center"
                             Margin="20"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Pagination Controls -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,10">
            <Button Content="◀"
                    Click="PrevPage_Click"
                    Width="40"
                    Height="30"
                    Margin="5"
                    Background="#3b82f6"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>
            <TextBlock x:Name="PageNumberText"
                       Foreground="White"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Margin="10,0"/>
            <Button Content="▶"
                    Click="NextPage_Click"
                    Width="40"
                    Height="30"
                    Margin="5"
                    Background="#3b82f6"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
