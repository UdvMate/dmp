<Window x:Class="dmp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard"
        Width="900"
        Height="600"
        Background="#171b21"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          Color="#000000"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.4"/>
    </Window.Resources>

    <Grid>
        <!-- Account Button and Popup -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0">
            <Button x:Name="AccountButton"
                    Content="Account"
                    Width="100"
                    Height="30"
                    Click="AccountButton_Click"
                    Background="#3b82f6"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>

            <Popup x:Name="AccountPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=AccountButton}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="#0e1116"
                        CornerRadius="8"
                        Padding="10"
                        BorderBrush="#3b82f6"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UserInfoText"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                        <Button Content="Logout"
                                Width="100"
                                Click="Logout_Click"
                                Background="#3b82f6"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Flashcards Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,60,0,0">
            <UniformGrid x:Name="FlashcardsPanel"  Columns="3" Rows="2" HorizontalAlignment="Center" Margin="40" IsItemsHost="False">
                <!-- Dynamic flashcards will be added here -->
            </UniformGrid>
        </ScrollViewer>

        <!-- Pagination Area -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Content="◀" Tag="1" Width="50" Height="30" Click="PageButton_Click" Background="#3b82f6" Foreground="White"/>
            <Button Content="1" Tag="1" Width="30" Height="30" Click="PageButton_Click" Background="#3b82f6" Foreground="White"/>
            <Button Content="2" Tag="2" Width="30" Height="30" Click="PageButton_Click" Background="#3b82f6" Foreground="White"/>
            <Button Content="3" Tag="3" Width="30" Height="30" Click="PageButton_Click" Background="#3b82f6" Foreground="White"/>
            <Button Content="▶" Tag="3" Width="50" Height="30" Click="PageButton_Click" Background="#3b82f6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
