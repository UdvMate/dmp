<Window x:Class="dmp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flashcard.ai" Height="600" Width="800"
        Background="#0e1116">
    <Grid>
        <!--GRID-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="8" Width="1" Background="#0e1116" HorizontalAlignment="Left" />

        <!--LOGO-->
        <TextBlock Text="Flashcard.ai" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Grid.Column="0" Grid.Row="0"/>

        <!--LIBRARY-->
        
        <!--ACCOUNT-->

        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,20,0,20" Grid.Column="0" Grid.Row="0">
            <Ellipse Width="30" Height="30" Fill="#EAEAEA">
                <Ellipse.Stroke>
                    <SolidColorBrush Color="#CCCCCC"/>
                </Ellipse.Stroke>
            </Ellipse>
            <Button x:Name="AccountButton" Content="Account" Width="100" Height="30"
                Click="AccountButton_Click"/>
            <!-- Animált lebegő menü -->
            <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}" 
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade">
                <Border Background="#FFF" CornerRadius="10" Padding="10" >
                    <StackPanel>
                        <TextBlock x:Name="UserInfoText" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Button Content="Logout" Width="100" Click="Logout_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- RIGHT SIDE -->
        <!--WELCOME TEXT-->

        
        <!--TEXT INPUT-->
        
    </Grid>
</Window>
