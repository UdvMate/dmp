<Window x:Class="dmp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flashcard.ai" Height="600" Width="800">
    <Grid>
        <!-- Left Sidebar -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Sidebar width -->
            <ColumnDefinition Width="*"/>
            <!-- Main content area -->
        </Grid.ColumnDefinitions>

        <Border Background="#F5F5F5" Grid.Column="0">
            <StackPanel Margin="10">
                <!-- App Title -->
                <TextBlock Text="Flashcard.ai" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Library Section -->
                <TextBlock Text="Library" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Biology Note 03.14" Width="180" Height="40" Margin="0,0,0,10"/>
                <Button Content="History Exam Revision" Width="180" Height="40"/>

                <!-- Bottom Section -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,20,0,0">
                    <Ellipse Width="30" Height="30" Fill="#EAEAEA">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#CCCCCC"/>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <TextBlock Text="Username" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,247,0,0" Height="189">
                <!-- Welcome Message -->
                <TextBlock Text="Welcome back, username!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="10"
                        Width="400" Height="152">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Copy or upload your notes . . ." FontSize="14"
                                   Foreground="#888888"/>
                        <!-- Upload Icon -->
                        <Button Width="40" Height="40" Background="#FFFFFF"
                                BorderBrush="#CCCCCC" Content="📎">
                            <!-- Add icon here (optional) -->
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Notes Upload Section -->
            </StackPanel>
        </Grid>
    </Grid>
</Window>
