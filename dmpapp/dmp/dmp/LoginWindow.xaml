<Window x:Class="dmp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dmp"
        mc:Ignorable="d"
        Title="Login" Height="300" Width="400">
    <Grid>
        <TextBlock Text="Username" HorizontalAlignment="Left" Margin="30,50,0,213"/>
        <TextBox x:Name="UsernameTextBox" HorizontalAlignment="Left" Margin="120,50,0,213" Width="200"/>
        <TextBlock Text="Password:" HorizontalAlignment="Left" Margin="30,100,0,163"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Margin="120,100,0,163" Width="200"/>
        <Button Content="Login" HorizontalAlignment="Left" Margin="120,150,0,0" Width="80" Height="40" Click="LoginButton_Click"/>
        <Button Content="Register" HorizontalAlignment="Left" Margin="220,150,0,0" Width="80" Height="40" Click="RegisterButton_Click"/>

    </Grid>
</Window>
