<Window x:Class="dmp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="600"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#171b21">

    <Window.Resources>
        <Style x:Key="GlowingButton" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#3b82f6"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="LoginPanel"
                Background="#0e1116"
                CornerRadius="12"
                Padding="50"
                Height="420"
                Width="450"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Opacity="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">

                <TextBlock Text="Login"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,40"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Username:"
                           Margin="0,0,0,15"
                           Foreground="#cbd5e1"/>
                <TextBox x:Name="UsernameTextBox"
                         Width="300"
                         Height="45"
                         Margin="0,0,0,25"
                         Background="#171b21"
                         Foreground="White"
                         BorderBrush="#3b82f6"
                         BorderThickness="1"/>

                <TextBlock Text="Password:"
                           Margin="0,0,0,15"
                           Foreground="#cbd5e1"/>
                <PasswordBox x:Name="PasswordBox"
                             Width="300"
                             Height="45"
                             Margin="0,0,0,35"
                             Background="#171b21"
                             Foreground="White"
                             BorderBrush="#3b82f6"
                             BorderThickness="1"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Login"
                            Width="140"
                            Height="20"
                            Margin="0,0,15,0"
                            Click="LoginButton_Click"
                            Style="{StaticResource GlowingButton}"/>
                    <Button Content="Register"
                            Width="140"
                            Click="RegisterButton_Click"
                            Style="{StaticResource GlowingButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LoginPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

</Window>
