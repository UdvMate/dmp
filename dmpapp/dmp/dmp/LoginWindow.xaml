<Window x:Class="dmp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dmp"
        mc:Ignorable="d"
        Title="Login" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Username:" Grid.Row="0" Grid.Column="0" Margin="30,10,5,5"/>
        <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1" Margin="5,10,30,5" Width="200" HorizontalAlignment="Left"/>

        <TextBlock Text="Password:" Grid.Row="1" Grid.Column="0" Margin="30,10,5,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="5,10,30,5" Width="200" HorizontalAlignment="Left"/>

        <Button Content="Login" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="5,20,0,10" Width="80" Click="LoginButton_Click"/>
        <Button Content="Register" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,20,30,10" Width="80" Click="RegisterButton_Click"/>
    </Grid>
</Window>
