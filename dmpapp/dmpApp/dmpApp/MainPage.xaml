<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dmpApp.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mappa navigáció -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Folders}" SelectionChanged="OnFolderSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" BackgroundColor="LightGray" CornerRadius="10" Margin="5">
                        <Label Text="{Binding Name}" FontSize="Medium" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Flashcardok megjelenítése -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Flashcards}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="20" BackgroundColor="WhiteSmoke" CornerRadius="15" Margin="10">
                        <StackLayout>
                            <Label Text="{Binding Question}" FontSize="Large" FontAttributes="Bold" />
                            <Label Text="{Binding Answer}" FontSize="Medium" Opacity="0" x:Name="AnswerLabel" />
                            <Button Text="Show Answer" Clicked="OnShowAnswerClicked" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
