<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dmpApp.Views.LoginPage"
             Title="Bejelentkezés">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Felhasználónév:" />
        <Entry x:Name="UsernameEntry" Placeholder="Add meg a felhasználóneved" />

        <Label Text="Jelszó:" />
        <Entry x:Name="PasswordEntry" Placeholder="Jelszó" IsPassword="True" />

        <Button Text="Bejelentkezés" Clicked="OnLoginClicked" />
    </VerticalStackLayout>
</ContentPage>
