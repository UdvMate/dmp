<Window x:Class="dmp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel" Height="500" Width="700"
        Background="#171b21">
    <Window.Resources>
        <!-- Kártya stílus (Dark Card) -->
        <Style x:Key="DarkCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0e1116"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
                Color="#000000" 
                BlurRadius="20" 
                ShadowDepth="4" 
                Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Kék Delete Gomb Stílus -->
        <Style x:Key="BlueDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Szöveg szín -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TextBlock Text="Admin Panel" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

        <!-- Lista a felhasználókról -->
        <ListBox Name="UserListBox" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="30,70,30,70" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource DarkCardStyle}">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Width="400">
                                <TextBlock Text="{Binding Username}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Email}" FontSize="14" Foreground="#aaa"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="View sets" Background="#facc15" Foreground="Black"
                        Padding="8,5" Margin="5"
                        FontSize="14" Cursor="Hand"
                        Click="ViewSetsButton_Click"/>
                                <Button Content="Delete" Style="{StaticResource BlueDeleteButtonStyle}"
                        Click="DeleteUserButton_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>

            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Frissítés gomb -->
        <Button Content="Refresh" Style="{StaticResource BlueDeleteButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Click="RefreshButton_Click"/>
    </Grid>
</Window>
